{
  "mcpServers": {
    "higgsfield": {
      "url": "https://mcp.higgsfield.ai/mcp",
      "headers": {
        "Authorization": "Key YOUR_HIGGSFIELD_KEY_HERE"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "github-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE"
      }
    },
    "memory-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "filesystem-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/storage/emulated/0/Antigravity"
      ]
    },
    "sequential-thinking": {
      "command": "node",
      "args": [
        "/data/user/0/com.agy/files/usr/bin/mcp-server-sequential-thinking"
      ]
    },
    "android-adb": {
      "command": "python",
      "args": [
        "/data/user/0/com.agy/files/services/adb-mcp/server.py"
      ]
    }
  }
}